{
  "name": "swissmouse",
  "version": "0.1.0-alpha.5",
  "license": "AGPL-3.0-or-later",
  "description": "Local-first modular SwissMouse Core host",
  "type": "module",
  "workspaces": [
    "packages/sdk"
  ],
  "scripts": {
    "dev": "tsx core-server.ts",
    "build": "vite build --config vite.core.config.ts && esbuild core-server.ts --bundle --platform=node --format=cjs --packages=external --outfile=dist/core-server.cjs",
    "start": "node dist/core-server.cjs",
    "lint": "tsc --noEmit",
    "test": "node --import tsx --test tools/application-runtime.test.ts"
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "buffer-crc32": "^1.0.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "lucide-react": "^1.16.0",
    "multer": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "saxes": "^6.0.0",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.9",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.13.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.0.9",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vite": "^6.1.1"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  },
  "engines": {
    "node": "^22.13.0 || >=23.4.0"
  }
}
